{
  "functions": {
    "api/index.py": {
      "includeFiles": "{app/**,web/dist/**}",
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"vercel-test\" ] && exit 1 || exit 0"
}
