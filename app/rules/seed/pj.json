{
  "business_line": "PJ",
  "inputs": [
    {"name": "wall_width_mm", "label": "Wall width 墙宽", "unit": "mm", "type": "number"},
    {"name": "wall_height_mm", "label": "Wall height 墙高", "unit": "mm", "type": "number"},
    {"name": "available_depth_mm", "label": "Available depth 可用进深", "unit": "mm", "type": "number"},
    {"name": "ceiling_height_mm", "label": "Ceiling height 天花高度", "unit": "mm", "type": "number"},
    {"name": "mounting", "label": "Mounting 安装方式", "type": "choice", "options": ["ceiling", "floor", "wall"]},
    {"name": "mount_height_m", "label": "Lens height 镜头高度", "unit": "m", "type": "number"},
    {"name": "mount_distance_m", "label": "Mount distance 安装距离（镜头前端到墙，不填按最短）", "unit": "m", "type": "number"},
    {"name": "lens_throw_ratio", "label": "Lens 镜头投射比（不填自动选）", "type": "number"},
    {"name": "ambient_lux", "label": "Ambient light 环境光", "unit": "lux", "type": "number"},
    {"name": "surface_gain", "label": "Surface gain 幕面增益", "type": "number"},
    {"name": "nearest_viewing_m", "label": "Nearest viewing 最近观看距离", "unit": "m", "type": "number"},
    {"name": "signal_run_m", "label": "Signal run 信号距离（播放源到投影机）", "unit": "m", "type": "number"},
    {"name": "source_location", "label": "Source location 播放源位置", "type": "choice", "options": ["server_room", "local"]},
    {"name": "central_control", "label": "Central control 中控", "type": "choice", "options": ["pjlink", "none"]},
    {"name": "transport_mode", "label": "Transport 传输方式", "type": "choice", "options": ["by_distance", "avoip"]},
    {"name": "server_room_scope", "label": "Server room power 机房功率口径", "type": "choice", "options": ["full", "media_pc_only"]},
    {"name": "existing_video_lines", "label": "Design video lines 原方案视频线（工作线）", "type": "number"},
    {"name": "existing_video_total", "label": "Design video cables 原方案视频线（含备用）", "type": "number"},
    {"name": "existing_control_total", "label": "Design control cables 原方案控制线（含备用）", "type": "number"},
    {"name": "native_px_w", "label": "Native width 投影机横向像素", "unit": "px", "type": "number"},
    {"name": "native_px_h", "label": "Native height 投影机纵向像素", "unit": "px", "type": "number"},
    {"name": "projector_lumens", "label": "Projector brightness 投影机流明", "unit": "lm", "type": "number"},
    {"name": "projector_power_w", "label": "Projector power 投影机功率", "unit": "W", "type": "number"}
  ],
  "params": [
    {"name": "overlap_min", "group": "Blending 融合", "label": "Blend minimum 融合带下限", "unit": "", "value": 0.15, "status": "set"},
    {"name": "overlap_max", "group": "Blending 融合", "label": "Blend maximum 融合带上限", "unit": "", "value": 0.3, "status": "set"},
    {"name": "target_nits", "group": "Brightness 亮度", "label": "Target brightness 目标亮度", "unit": "nits", "value": 100, "status": "sample"},
    {"name": "derate", "group": "Brightness 亮度", "label": "Derate 亮度折减", "unit": "", "value": 0.8, "status": "sample"},
    {"name": "pixel_rule_m_per_mm", "group": "Checks 校核", "label": "Min. viewing distance 最近观看距离（每 mm 像素）", "unit": "m", "value": 1.0, "status": "set"},
    {"name": "person_height_m", "group": "Checks 校核", "label": "Person height 人高", "unit": "m", "value": 1.8, "status": "set"},
    {"name": "corner_clash_m", "group": "Checks 校核", "label": "Corner clearance 转角机位最小间距", "unit": "m", "value": 0.6, "status": "sample"},
    {"name": "circuit_kw", "group": "Power & cables 电源与线缆", "label": "Power per circuit 每回路功率", "unit": "kW", "value": 2.5, "status": "set"},
    {"name": "power_margin", "group": "Power & cables 电源与线缆", "label": "Power margin 功率余量", "unit": "", "value": 0.1, "status": "set"},
    {"name": "hdmi_max_m", "group": "Power & cables 电源与线缆", "label": "HDMI limit HDMI 上限", "unit": "m", "value": 15, "status": "set"},
    {"name": "fiber_over_m", "group": "Power & cables 电源与线缆", "label": "Fiber above 超过改光纤", "unit": "m", "value": 50, "status": "set"},
    {"name": "spare_ratio", "group": "Power & cables 电源与线缆", "label": "Spare rate 备用比例", "unit": "", "value": 0.1, "status": "set"},
    {"name": "spare_min", "group": "Power & cables 电源与线缆", "label": "Spare minimum 备用最少", "unit": "根", "value": 1, "status": "set"},
    {"name": "media_pc_w", "group": "Server room 机房", "label": "Media PC 播控电脑", "unit": "W", "value": 500, "status": "sample"},
    {"name": "blender_w", "group": "Server room 机房", "label": "Blender 融合器", "unit": "W", "value": 150, "status": "sample"},
    {"name": "hdbaset_tx_w", "group": "Server room 机房", "label": "HDBaseT transmitter, each HDBaseT 发送器（每台）", "unit": "W", "value": 15, "status": "sample"},
    {"name": "control_switch_w", "group": "Server room 机房", "label": "Control switch 中控交换机", "unit": "W", "value": 60, "status": "sample"},
    {"name": "ups_pf", "group": "Server room 机房", "label": "UPS power factor UPS 功率因数", "unit": "", "value": 0.8, "status": "sample"}
  ],
  "rules": [
    {"id": "P1", "title": "Single image width 单台画面宽", "note": "墙高 × 投影机长宽比（16:10 为 1.6）。",
     "outputs": [{"name": "single_w_m", "unit": "m", "decimals": 2, "cases": [{"expr": "wall_height_mm / 1000 * native_px_w / native_px_h"}]}]},
    {"id": "P3", "title": "Lens 选镜头", "note": "每款可配镜头算最短距离 = 投射比 × 画面宽，取放得进可用进深、投射比最小的（人影少）。", "step": "lens_pick"},
    {"id": "P4", "title": "Actual image 实际画面", "note": "定焦镜头：实际画面宽 = 安装距离 ÷ 投射比，高 = 宽 ÷ 长宽比。", "display": "{image_w_m} × {image_h_m} m",
     "outputs": [
       {"name": "image_w_m", "unit": "m", "decimals": 2, "cases": [{"expr": "distance_m / throw_ratio"}]},
       {"name": "image_h_m", "unit": "m", "decimals": 2, "cases": [{"expr": "image_w_m * native_px_h / native_px_w"}]}]},
    {"id": "P2", "title": "Projector count 台数", "note": "ceil((墙宽 − 画面宽) ÷ (画面宽 × (1 − 融合下限))) + 1，至少 1 台。",
     "outputs": [{"name": "projectors", "unit": "台", "cases": [{"expr": "max(1, ceil((wall_width_mm / 1000 - image_w_m) / (image_w_m * (1 - overlap_min))) + 1)"}]}]},
    {"id": "P5", "title": "Blend zone 融合带", "note": "1 − (墙宽 − 画面宽) ÷ ((台数 − 1) × 画面宽)，要在融合上下限之间。", "check": true,
     "display": "{overlap_pct} % · {overlap_m} m",
     "outputs": [
       {"name": "overlap", "decimals": 3, "cases": [{"when": "projectors == 1", "expr": "0"}, {"expr": "1 - (wall_width_mm / 1000 - image_w_m) / ((projectors - 1) * image_w_m)"}]},
       {"name": "overlap_pct", "unit": "%", "decimals": 1, "cases": [{"expr": "overlap * 100"}]},
       {"name": "overlap_m", "unit": "m", "decimals": 2, "cases": [{"expr": "overlap * image_w_m"}]},
       {"name": "blend_check", "cases": [{"expr": "'PASS' if projectors == 1 or (overlap >= overlap_min and overlap <= overlap_max) else 'NOTE'"}]}]},
    {"id": "P6", "title": "Height coverage 画面高覆盖", "note": "实际画面高 ≥ 墙高。", "check": true,
     "outputs": [{"name": "height_check", "cases": [{"expr": "'PASS' if image_h_m * 1000 >= wall_height_mm else 'NOTE'"}]}]},
    {"id": "P7", "title": "Blended resolution 拼接分辨率", "note": "台数 × 横向像素 − (台数 − 1) × 融合带 × 横向像素。", "display": "{blended_px_x} × {blended_px_y}",
     "outputs": [
       {"name": "blended_px_x", "unit": "px", "cases": [{"expr": "round(projectors * native_px_w - (projectors - 1) * overlap * native_px_w)"}]},
       {"name": "blended_px_y", "unit": "px", "cases": [{"expr": "native_px_h"}]}]},
    {"id": "P8", "title": "Pixel size 像素尺寸", "note": "墙宽 ÷ 横向像素；最近观看距离小于像素尺寸 × 每 mm 米数时提示清晰度不够。", "check": true,
     "display": "{pixel_mm} mm",
     "outputs": [
       {"name": "pixel_mm", "unit": "mm", "decimals": 1, "cases": [{"expr": "wall_width_mm / blended_px_x"}]},
       {"name": "clarity_check", "cases": [{"expr": "'NOTE' if nearest_viewing_m < pixel_mm * pixel_rule_m_per_mm else 'PASS'"}]}]},
    {"id": "P9", "title": "Lumens 单台流明", "note": "目标亮度 × π × 单台画面面积 ÷ 幕面增益 ÷ 折减；投影机流明要不低于此值。", "check": true,
     "display": "{lumens_required} lm",
     "outputs": [
       {"name": "lumens_required", "unit": "lm", "decimals": 0, "cases": [{"expr": "target_nits * pi * image_w_m * image_h_m / surface_gain / derate"}]},
       {"name": "lumens_check", "cases": [{"expr": "'PASS' if projector_lumens >= lumens_required else 'NOTE'"}]}]},
    {"id": "P10", "title": "Shadow 剖面遮挡", "note": "从镜头到画面底边的光线，按人高检查离墙多远以内会挡光。", "step": "occlusion"},
    {"id": "P11", "title": "Blender 融合器", "note": "2 台及以上必须用融合器，输出路数 ≥ 台数。", "step": "blender_pick"},
    {"id": "P14", "title": "Transport 传输方式", "note": "距离 ≤ HDMI 上限用 HDMI；不超过光纤门槛用 HDBaseT；更远用光纤 HDMI；项目有 AV 网络时用 AVoIP。", "step": "transport_pick"},
    {"id": "P12", "title": "Power 电源", "note": "(台数 × 投影机功率 + 机房功率) × (1 + 余量) ÷ 每回路功率，向上取整。", "display": "{power_with_margin_kw} kW · {circuits}",
     "outputs": [
       {"name": "server_room_w", "unit": "W", "cases": [
         {"when": "server_room_scope == 'media_pc_only'", "expr": "media_pc_w"},
         {"expr": "media_pc_w + (blender_w if projectors >= 2 else 0) + (hdbaset_tx_w * projectors if transport == 'HDBaseT' else 0) + (control_switch_w if central_control == 'pjlink' else 0)"}]},
       {"name": "power_kw", "unit": "kW", "decimals": 2, "cases": [{"expr": "(projectors * projector_power_w + server_room_w) / 1000"}]},
       {"name": "power_with_margin_kw", "unit": "kW", "decimals": 2, "cases": [{"expr": "power_kw * (1 + power_margin)"}]},
       {"name": "circuits", "unit": "路", "cases": [{"expr": "ceil(power_with_margin_kw / circuit_kw)"}]}]},
    {"id": "P13", "title": "Content canvas 内容画布", "note": "画布 = 拼接横向像素 × 纵向像素；时长和场景数由人填。", "display": "{canvas_px_x} × {canvas_px_y}",
     "outputs": [
       {"name": "canvas_px_x", "unit": "px", "cases": [{"expr": "blended_px_x"}]},
       {"name": "canvas_px_y", "unit": "px", "cases": [{"expr": "blended_px_y"}]}]},
    {"id": "P15", "title": "Cables 线缆清单", "note": "视频线 = 台数，控制线（PJLink）= 台数；每类备用 max(最少数, 台数 × 备用比例 向上取整)。", "display": "{total_cat6} CAT6",
     "outputs": [
       {"name": "video_lines", "unit": "根", "cases": [{"expr": "projectors"}]},
       {"name": "video_spare", "unit": "根", "cases": [{"expr": "max(spare_min, ceil(projectors * spare_ratio))"}]},
       {"name": "control_lines", "unit": "根", "cases": [{"when": "central_control == 'pjlink'", "expr": "projectors"}, {"expr": "0"}]},
       {"name": "control_spare", "unit": "根", "cases": [{"when": "central_control == 'pjlink'", "expr": "max(spare_min, ceil(projectors * spare_ratio))"}, {"expr": "0"}]},
       {"name": "total_cat6", "unit": "根", "cases": [{"expr": "(video_lines + video_spare if transport == 'HDBaseT' or transport == 'AVoIP' else 0) + control_lines + control_spare"}]}]},
    {"id": "P16", "title": "Power points 电源点", "note": "每台投影 1 个 13A 电源点；机房设备功率 × (1 + 余量)；方案 A 预留插座，方案 B UPS。", "step": "power_points"},
    {"id": "P17", "title": "Consistency 中控与一致性", "note": "视频线 = 控制线 = 台数；融合器输出 ≥ 台数；和原方案的数量核对；投影只用网络指令待机，不直接断电。", "step": "consistency"}
  ]
}
