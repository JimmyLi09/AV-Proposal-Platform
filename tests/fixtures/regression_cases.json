  "phoenix_sea_checks": {
    "source": "Blackfort · Phoenix Sea Office system-integration review (2026-10-14/15). Behaviour cases only; wall sizes not provided yet.",
    "cases": [
      {
        "name": "count mismatch",
        "input": {
          "projectors": 4,
          "video_lines": 5
        },
        "expect": "BLOCK: P17 video lines must equal projector count"
      },
      {
        "name": "text vs drawing conflict",
        "input": {
          "count_in_text": 4,
          "count_in_drawing_note": 6
        },
        "expect": "field goes to confirmation gate as conflict, cannot calculate until confirmed"
      },
      {
        "name": "long HDMI",
        "input": {
          "signal_run_m": 20
        },
        "expect": "P14 -> HDBaseT (HDMI only up to 15 m)"
      },
      {
        "name": "fiber",
        "input": {
          "signal_run_m": 60
        },
        "expect": "P14 -> fiber HDMI"
      },
      {
        "name": "spares",
        "input": {
          "projectors": 2
        },
        "expect": "video 2 + 1 spare, control 2 + 1 spare"
      },
      {
        "name": "Past Zone option 1 (slide 06)",
        "input": {
          "projectors": 2,
          "lumens": 9000,
          "native_px": [
            1920,
            1200
          ],
          "lens_throw_ratio": 0.55,
          "hdmi": 3,
          "cat6": 3,
          "source_location": "server_room"
        },
        "expect": "P15 PASS (video 2+1, control 2+1 matches 3 HDMI + 3 CAT6); P14 -> HDBaseT or fiber because run from Server Room > 15 m. Wall size not given on slide -> geometry (P1-P10) not tested yet"
      }
    ]
  },
