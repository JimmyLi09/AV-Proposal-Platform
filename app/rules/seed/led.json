{
  "business_line": "LED",
  "inputs": [
    {"name": "environment", "label": "Environment 使用环境", "type": "choice", "options": ["indoor", "outdoor", "rental"]},
    {"name": "pixel_pitch_mm", "label": "Pixel pitch 点间距", "unit": "mm", "type": "number"},
    {"name": "width_mm", "label": "Screen width 屏宽", "unit": "mm", "type": "number"},
    {"name": "height_mm", "label": "Screen height 屏高", "unit": "mm", "type": "number"},
    {"name": "module_w_mm", "label": "Module width 模组宽", "unit": "mm", "type": "number"},
    {"name": "module_h_mm", "label": "Module height 模组高", "unit": "mm", "type": "number"},
    {"name": "cabinet_sizes_mm", "label": "Cabinet sizes 箱体尺寸（第一个为主尺寸）", "unit": "mm", "type": "sizes"},
    {"name": "viewing_distance_m", "label": "Viewing distance 观看距离", "unit": "m", "type": "range"},
    {"name": "installation", "label": "Installation 安装方式", "type": "choice", "options": ["wall", "floor", "hanging", "embedded"]},
    {"name": "maintenance", "label": "Maintenance 维护方式", "type": "choice", "options": ["front", "rear"]},
    {"name": "brightness_required_nits", "label": "Required brightness 亮度要求", "unit": "nits", "type": "number"},
    {"name": "signal_sources", "label": "Signal sources 信号源数量", "unit": "路", "type": "number"}
  ],
  "params": [
    {"name": "spare_power_cables", "group": "Power & cables 电源与线缆", "label": "Spare power cables 备用电源线", "unit": "根", "value": 1, "status": "review"},
    {"name": "spare_data_cables", "group": "Power & cables 电源与线缆", "label": "Spare data cables 备用信号线", "unit": "根", "value": 1, "status": "set"},
    {"name": "circuits_per_db_box", "group": "Power & cables 电源与线缆", "label": "Circuits per DB box 每配电箱回路数", "unit": "路", "value": 4, "status": "sample"},
    {"name": "mcb_a", "group": "Load budget 带载预算", "label": "MCB rating (single phase) 空开（单相）", "unit": "A", "value": 20, "status": "set", "source": "公司标准（Jimmy）"},
    {"name": "mains_v", "group": "Load budget 带载预算", "label": "Mains voltage 市电电压", "unit": "V", "value": 230, "status": "set", "source": "新加坡市电"},
    {"name": "load_factor", "group": "Load budget 带载预算", "label": "Continuous load factor 持续负载系数", "unit": "", "value": 0.85, "status": "set", "source": "Jimmy：先用 0.85，可以参考以前的数据"},
    {"name": "power_cable_mm2", "group": "Load budget 带载预算", "label": "Power cable size 电源线线径", "unit": "mm²", "value": 2.5, "status": "set", "options": [1.5, 2.5, 4], "source": "Thailand P1.8 接线图（3 × 2.5 mm²）"},
    {"name": "chain_max", "group": "Load budget 带载预算", "label": "Max cabinets per power chain 每条电源线最多串接箱体", "unit": "个", "value": 10, "status": "set", "source": "Jimmy：按电源带载和箱体尺寸，最多 10–12 个，取 10"},
    {"name": "px_per_data_cable", "group": "Load budget 带载预算", "label": "Pixels per network port 每网口带载", "unit": "px", "value": 655360, "status": "set", "source": "厂家标称 655,360 = 1024 × 640（Absen 资料）；按公式 1000 Mbps × 93.6% ÷ 60 Hz ÷ 24 bit ≈ 650,000，MCTRL700 规格书约 650,000"},
    {"name": "data_grouping", "group": "Load budget 带载预算", "label": "Data grouping 网线分组", "unit": "", "value": "rows", "status": "review", "options": ["rows", "count"], "source": "默认按行整行（公司接线图做法，Thailand P1.8）；待 Jimmy 确认"},
    {"name": "ampacity_1_5_mm2", "group": "Cable ampacity 线径载流", "label": "Ampacity 1.5 mm² 1.5 mm² 载流", "unit": "A", "value": 16, "status": "sample", "source": "示例值，待公司用线的实际载流量"},
    {"name": "ampacity_2_5_mm2", "group": "Cable ampacity 线径载流", "label": "Ampacity 2.5 mm² 2.5 mm² 载流", "unit": "A", "value": 20, "status": "sample", "source": "示例值，待公司用线的实际载流量"},
    {"name": "ampacity_4_mm2", "group": "Cable ampacity 线径载流", "label": "Ampacity 4 mm² 4 mm² 载流", "unit": "A", "value": 27, "status": "sample", "source": "示例值，待公司用线的实际载流量"},
    {"name": "wiring_orientation", "group": "Wiring 接线", "label": "Wiring direction 接线方向", "unit": "", "value": "row", "status": "set", "options": ["row", "col"], "source": "公司接线图按行（Thailand P1.8）"},
    {"name": "power_route", "group": "Wiring 接线", "label": "Power routing 电源走线", "unit": "", "value": "S", "status": "set", "options": ["S", "straight"]},
    {"name": "data_route", "group": "Wiring 接线", "label": "Data routing 网线走线", "unit": "", "value": "straight", "status": "set", "options": ["S", "straight"]},
    {"name": "w_per_m2_indoor", "group": "Power density 功率密度", "label": "Indoor fixed 室内固装", "unit": "W/㎡", "value": 500, "status": "set"},
    {"name": "w_per_m2_outdoor", "group": "Power density 功率密度", "label": "Outdoor fixed 户外固装", "unit": "W/㎡", "value": 800, "status": "sample"},
    {"name": "w_per_m2_rental", "group": "Power density 功率密度", "label": "Rental 租赁", "unit": "W/㎡", "value": 600, "status": "sample"},
    {"name": "spare_module_ratio", "group": "Spares 备品", "label": "Module spare rate 模组备品比例", "unit": "", "value": 0.05, "status": "sample"},
    {"name": "spare_module_min", "group": "Spares 备品", "label": "Module spare minimum 模组备品最少", "unit": "块", "value": 2, "status": "sample"},
    {"name": "spare_psu_ratio", "group": "Spares 备品", "label": "PSU / receiving card spare rate 电源 / 接收卡备品比例", "unit": "", "value": 0.02, "status": "sample"},
    {"name": "spare_psu_min", "group": "Spares 备品", "label": "PSU / receiving card spare minimum 电源 / 接收卡备品最少", "unit": "个", "value": 1, "status": "sample"},
    {"name": "viewing_m_per_mm", "group": "Checks 校核", "label": "Min. viewing distance 最近观看距离（每 mm 点间距）", "unit": "m", "value": 1.0, "status": "review"},
    {"name": "output_max_px_w", "group": "Checks 校核", "label": "Output width limit 每路输出宽度上限（多面屏 S5）", "unit": "px", "value": 3840, "status": "sample"}
  ],
  "rules": [
    {"id": "F1", "title": "Area 面积", "note": "屏宽 × 屏高。",
     "outputs": [{"name": "area_m2", "unit": "㎡", "decimals": 2, "cases": [{"expr": "width_mm * height_mm / 1000000"}]}]},
    {"id": "F2", "title": "Modules 模组", "note": "宽、高各除以模组尺寸取整后相乘。",
     "outputs": [
       {"name": "modules_x", "unit": "块", "cases": [{"expr": "floor(width_mm / module_w_mm)"}]},
       {"name": "modules_y", "unit": "块", "cases": [{"expr": "floor(height_mm / module_h_mm)"}]},
       {"name": "modules", "unit": "块", "cases": [{"expr": "modules_x * modules_y"}]}]},
    {"id": "F3", "title": "Cabinet layout 箱体排布", "note": "每列先尽量用主尺寸（第一个箱体尺寸），余下用其它尺寸补齐。", "step": "cabinet_layout"},
    {"id": "F4", "title": "Resolution 分辨率", "note": "模组数 × 每块模组的像素。", "display": "{res_x} × {res_y}",
     "outputs": [
       {"name": "res_x", "unit": "px", "cases": [{"expr": "modules_x * round(module_w_mm / pixel_pitch_mm)"}]},
       {"name": "res_y", "unit": "px", "cases": [{"expr": "modules_y * round(module_h_mm / pixel_pitch_mm)"}]},
       {"name": "total_pixels", "unit": "px", "cases": [{"expr": "res_x * res_y"}]}]},
    {"id": "F5", "title": "Power 功率", "note": "Σ（各尺寸箱体数 × 每箱最大功率）÷ 1000，箱体数来自 F3、每箱最大功率来自产品库；产品没有每箱最大功率时，退回按面积 × 每平米功耗。",
     "outputs": [{"name": "power_kw", "unit": "kW", "decimals": 2, "cases": [
       {"when": "cabinets_w > 0", "expr": "cabinets_w / 1000"},
       {"when": "environment == 'indoor'", "expr": "area_m2 * w_per_m2_indoor / 1000"},
       {"when": "environment == 'outdoor'", "expr": "area_m2 * w_per_m2_outdoor / 1000"},
       {"when": "environment == 'rental'", "expr": "area_m2 * w_per_m2_rental / 1000"}]}]},
    {"id": "F6", "title": "Power circuits 电源回路", "note": "每回路额定电流取空开和线径载流的小者，乘持续负载系数得可用电流；按最大单箱电流算每回路能带几箱（带载），再按每条电源线最多串接几箱（串接），两者取大。",
     "display": "{circuits}（带载 {circuits_by_load} / 串接 {circuits_by_chain}，取大）",
     "outputs": [
       {"name": "rated_a", "unit": "A", "cases": [
         {"when": "power_cable_mm2 == 1.5", "expr": "min(mcb_a, ampacity_1_5_mm2)"},
         {"when": "power_cable_mm2 == 4", "expr": "min(mcb_a, ampacity_4_mm2)"},
         {"expr": "min(mcb_a, ampacity_2_5_mm2)"}]},
       {"name": "usable_a", "unit": "A", "decimals": 2, "cases": [{"expr": "rated_a * load_factor"}]},
       {"name": "usable_kw", "unit": "kW", "decimals": 2, "cases": [{"expr": "usable_a * mains_v / 1000"}]},
       {"name": "cab_per_circuit", "unit": "个", "cases": [{"expr": "floor(usable_a / cabinet_max_a)"}]},
       {"name": "circuits_by_load", "unit": "路", "cases": [{"expr": "ceil(cabinets / cab_per_circuit)"}]},
       {"name": "circuits_by_chain", "unit": "路", "cases": [{"expr": "ceil(cabinets / chain_max)"}]},
       {"name": "circuits", "unit": "路", "cases": [{"expr": "max(circuits_by_load, circuits_by_chain)"}]}]},
    {"id": "F7", "title": "Power cables 电源线", "note": "回路数 + 备用。",
     "outputs": [{"name": "power_cables", "unit": "根", "cases": [{"expr": "circuits + spare_power_cables"}]}]},
    {"id": "F8", "title": "Spare PSU / receiving card 备用电源 / 接收卡", "note": "按箱体数取比例向上取整，不低于最少数（按每箱 1 个电源、1 张接收卡估算）。",
     "display": "{spare_psu} + {spare_rx_cards}",
     "outputs": [
       {"name": "spare_psu", "unit": "个", "cases": [{"expr": "max(ceil(cabinets * spare_psu_ratio), spare_psu_min)"}]},
       {"name": "spare_rx_cards", "unit": "张", "cases": [{"expr": "max(ceil(cabinets * spare_psu_ratio), spare_psu_min)"}]}]},
    {"id": "W1", "title": "Wiring layout 接线布置", "note": "电源从最下一行靠配电箱一侧开始，按走线顺序把箱体连续平均分成 F6 的回路数；网线从最上一行靠发送卡一侧开始，按行整行或按箱数装。逐组检查电流、串接箱数和像素。", "step": "wiring_layout"},
    {"id": "F9", "title": "Data cables 数据线", "note": "按箱数最少要 ⌈总像素 ÷ 每网口带载⌉ 路；按行整行时用 W1 从上往下装整行的路数。再加备用。",
     "outputs": [
       {"name": "data_runs_count", "unit": "路", "cases": [{"expr": "ceil(total_pixels / px_per_data_cable)"}]},
       {"name": "data_runs", "unit": "路", "cases": [
         {"when": "data_grouping == 'rows'", "expr": "wiring_data_runs"},
         {"expr": "data_runs_count"}]},
       {"name": "data_cables", "unit": "根", "cases": [{"expr": "data_runs + spare_data_cables"}]}]},
    {"id": "F10", "title": "Spare modules 备用模组", "note": "模组数取比例向上取整，不低于最少数。",
     "outputs": [{"name": "spare_modules", "unit": "块", "cases": [{"expr": "max(ceil(modules * spare_module_ratio), spare_module_min)"}]}]},
    {"id": "F11", "title": "Controller 控制器", "note": "带载像素和网口数都要够，否则阻断。", "step": "controller_pick"},
    {"id": "F12", "title": "DB box 配电箱", "note": "回路数 ÷ 每配电箱回路数，向上取整。",
     "outputs": [{"name": "db_boxes", "unit": "个", "cases": [{"expr": "ceil(circuits / circuits_per_db_box)"}]}]},
    {"id": "F13", "title": "Video processor 视频处理器", "note": "按信号源数量和分辨率选型。", "step": "processor_pick"},
    {"id": "F14", "title": "Viewing distance 观看距离", "note": "点间距 × 每 mm 对应的米数 ≤ 最近观看距离。", "check": true,
     "outputs": [{"name": "viewing_check", "cases": [{"expr": "'PASS' if pixel_pitch_mm * viewing_m_per_mm <= min(viewing_distance_m) else 'NOTE'"}]}]},
    {"id": "F15", "title": "Brightness 亮度", "note": "产品亮度 ≥ 环境要求的亮度。", "check": true,
     "outputs": [{"name": "brightness_check", "cases": [{"expr": "'PASS' if cabinet_brightness_nits >= brightness_required_nits else 'NOTE'"}]}]},
    {"id": "F16", "title": "Installation 安装", "note": "按安装方式带出配件。", "status": "sample",
     "outputs": [{"name": "installation_items", "cases": [
       {"when": "installation == 'wall'", "expr": "'墙面支架 1 套（不含钢结构）'"},
       {"when": "installation == 'floor'", "expr": "'落地支架 1 套（不含钢结构）'"},
       {"when": "installation == 'hanging'", "expr": "'吊装支架 1 套（不含钢结构）'"},
       {"when": "installation == 'embedded'", "expr": "'嵌入式边框 1 套（不含钢结构）'"}]}]}
  ]
}
